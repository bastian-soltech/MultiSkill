{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information and preferences.",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "createdAt"]
    },
    "Skill": {
      "title": "Learning Skill",
      "description": "A skill or topic the user is learning, including roadmap and progress.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "targetDuration": { "type": "number" },
        "targetUnit": { "type": "string", "enum": ["days", "weeks", "months", "years"] },
        "progress": { "type": "number" },
        "roadmap": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "task": { "type": "string" },
              "completed": { "type": "boolean" }
            }
          }
        },
        "attendance": { "type": "array", "items": { "type": "string" } },
        "isPublic": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "targetDuration", "targetUnit", "progress", "createdAt"]
    },
    "Log": {
      "title": "Learning Log",
      "description": "Daily notes for a specific skill.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "skillId": { "type": "string" },
        "note": { "type": "string" },
        "date": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "skillId", "note", "date"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profile data."
    },
    "skills/{skillId}": {
      "schema": "Skill",
      "description": "Skills and roadmaps."
    },
    "logs/{logId}": {
      "schema": "Log",
      "description": "Learning progress logs."
    }
  }
}
